DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unicore
DATABASE_SSL=false
PORT=3001

# Use independent, randomly generated values with at least 32 characters.
AUTH_JWT_SECRET=replace-with-a-long-random-signing-secret
AUTH_JWT_EXPIRES_IN_SECONDS=3600
AUTH_BOOTSTRAP_SECRET=replace-with-a-different-long-random-bootstrap-secret

# Login brute-force and concurrent scrypt protection (per backend instance).
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=20
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_ACCOUNT=5
AUTH_LOGIN_RATE_LIMIT_MAX_CONCURRENT=16
AUTH_LOGIN_RATE_LIMIT_MAX_CONCURRENT_PER_IP=4
AUTH_LOGIN_RATE_LIMIT_MAX_CONCURRENT_PER_ACCOUNT=2
