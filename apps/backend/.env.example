DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unicore
DATABASE_SSL=false
PORT=3001

# Use independent, randomly generated values with at least 32 characters.
AUTH_JWT_SECRET=replace-with-a-long-random-signing-secret
AUTH_JWT_EXPIRES_IN_SECONDS=3600
AUTH_BOOTSTRAP_SECRET=replace-with-a-different-long-random-bootstrap-secret
